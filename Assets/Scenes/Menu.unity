  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#FFD95A>Integrantes</color></b>\nAmanda Pazold dos Santos\nCesar Otavio da Silva Boiani\nGiovana Giraldeli\nGiovani Nogueira Pires\nMarcus Vinicius da Silva Capeteruchi\n\n<b><color=#FFD95A>Arte</color></b>\nSprites: CraftPix.net, pacotes gratuitos \"Free Racing Game Kit\" e \"Free Race Track 2D Game Tile Set\" (licen\xE7a Freebie: craftpix.net/file-licenses)\nMoeda, c\xEDrculos e marcas de pneu: desenhados por c\xF3digo no pr\xF3prio projeto\n\n<b><color=#FFD95A>M\xFAsicas</color></b> (todas de MintoDog, licen\xE7a CC0, OpenGameArt.org)\nPure Raceway (Treino) \xB7 Sunny City (Rio de Janeiro) \xB7 Joyful Jungle (Amaz\xF4nia)\nHot Roadway [Remake] (Nevada) \xB7 Neon sign Circuit [Remake] (T\xF3quio)\nRacing Game Menu (menu) \xB7 Racing Game Finish & Jingle (vit\xF3ria e derrota)\n\n<b><color=#FFD95A>Efeitos sonoros</color></b>\nMotor: \"racing car engine sound loops\", de domasx2 (CC0, OpenGameArt.org)\nBatidas: \"Impact Sounds\", de Kenney (CC0, kenney.nl)\nFogos e escapamento: \"25 CC0 bang / firework SFX\", de rubberduck (CC0, OpenGameArt.org)\nMoeda, compra e erro: \"Level up, power up, Coin get\", de wobbleboxx (CC0, OpenGameArt.org)\nNitro: \"Boost or Launch or Thruster\", de EZduzziteh (CC0, OpenGameArt.org)\nLargada: \"Race Start Countdown\", de kheetor (CC0, OpenGameArt.org)\nDerrapagem: \"Car tire squeal skid loop\", de audible-edge (Tom Haigh), licen\xE7a CC-BY 3.0 (creativecommons.org/licenses/by/3.0)\n\n<b><color=#FFD95A>Ferramentas</color></b>\nUnity 6 (6000.6.7f1), Universal Render Pipeline 2D, Input System e TextMesh Pro\nFonte Liberation Sans (SIL Open Font License)\nDesenvolvido com apoio do assistente de programa\xE7\xE3o Claude, da Anthropic. A disciplina permite o uso de IA."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
